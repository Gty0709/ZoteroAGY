{
  "name": "zotero-agy",
  "type": "module",
  "version": "1.2.4",
  "description": "AI Research Assistant for Zotero - Powered by Antigravity",
  "config": {
    "addonName": "Zotero AGY",
    "addonID": "zotero-agy@antigravity.org",
    "addonRef": "zoteroagy",
    "addonInstance": "ZoteroAGY",
    "prefsPrefix": "extensions.zotero.zoteroagy"
  },
  "author": "Gty0709",
  "homepage": "https://github.com/Gty0709/ZoteroAGY#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gty0709/ZoteroAGY.git"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "deploy": "node deploy.cjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/katex": "^0.16.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.3",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
